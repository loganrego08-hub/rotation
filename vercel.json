{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" }
      ]
    },
    {
      "source": "/(app.js|lib.js|styles.css|config.js)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "functions": {
    "api/page.js": { "includeFiles": "index.html" }
  },
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/album/:id", "destination": "/api/page?kind=album&id=:id" },
    { "source": "/list/:id", "destination": "/api/page?kind=list&id=:id" },
    { "source": "/artist/:id", "destination": "/api/page?kind=artist&id=:id" },
    { "source": "/u/:username", "destination": "/api/page?kind=profile&username=:username" },
    { "source": "/((?!api/|fonts/|tests/|.*\\.[A-Za-z0-9]+$).*)", "destination": "/api/page?path=/$1" }
  ]
}